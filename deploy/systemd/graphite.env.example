# /etc/graphite/graphite.env — read by graphite.service (EnvironmentFile=).
# root:root, mode 0600: systemd reads it before dropping to the service's
# dynamic user, which cannot read it back.
#
# Set by the unit itself, not here: GRAPHITE_DATA_DIR, GRAPHITE_REGISTRY_STATE,
# GRAPHITE_AUDIT_ANCHOR_DIR, GRAPHITE_AUDIT_KEY_FILE (a systemd credential),
# GRAPHITE_TRUST_PROXY=1 and GRAPHITE_TRUSTED_PROXIES=127.0.0.1,::1 (Caddy in
# front, on loopback), GRAPHITE_LOG_FORMAT=json.
# Every variable is documented in the repository's .env.example.

# REQUIRED. Each `openssl rand -hex 32`; all three different.
# deploy/scripts/rotate-keys.sh env /etc/graphite/graphite.env GRAPHITE_API_KEY
GRAPHITE_API_KEY=
# Operator routes (/admin/*). Leave empty to disable them — the safe default
# when nobody is using them.
GRAPHITE_ADMIN_API_KEY=
# Prometheus and the dashboard: /metrics, /manifests, GET /api/* only.
GRAPHITE_READ_API_KEY=

# Pin the wallet policy server-side: a caller-supplied profile is a policy the
# (possibly prompt-injected) agent chooses. treasury | trading | gaming |
# enterprise | custom:<min_confidence>:<TrustTier>
GRAPHITE_WALLET_PROFILE=treasury

# Without an RPC every verdict is analysis-only (`executable: false`).
# The URLs usually embed a provider key: they are secrets.
GRAPHITE_RPC_URL=
# A second, independent provider for L8 inclusion checks.
GRAPHITE_RPC_WITNESS_URL=
# High-assurance L8: no inclusion conclusion without an agreeing independent
# witness. Needs both URLs on https and both providers named.
# GRAPHITE_L8_HIGH_ASSURANCE=1
# GRAPHITE_RPC_PROVIDER=
# GRAPHITE_RPC_WITNESS_PROVIDER=

GRAPHITE_RATE_LIMIT=30
GRAPHITE_MAX_CONCURRENT=32
GRAPHITE_MAX_CONNECTIONS=1024
# Behind GRAPHITE_TRUST_PROXY the per-peer connection cap does not apply to
# the addresses in GRAPHITE_TRUSTED_PROXIES (every client's connection comes
# from Caddy) unless GRAPHITE_MAX_CONNECTIONS_PER_IP is set; every other peer
# keeps the default cap of 64 (Round 40). The per-client request rate limit
# above applies by the X-Forwarded-For address Caddy sets. Stock Caddy has no
# per-client connection cap: put one at the network edge (firewall / load
# balancer) if you need it.

# Audit rotation: 64 MiB active file, every archive kept (Constitution P9).
GRAPHITE_AUDIT_ROTATE_BYTES=67108864
GRAPHITE_AUDIT_MAX_ARCHIVES=0

GRAPHITE_CORS_ORIGINS=
RUST_LOG=info
