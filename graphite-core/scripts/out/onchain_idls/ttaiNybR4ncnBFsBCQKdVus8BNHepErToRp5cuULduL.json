     {
      "name": "admin",
      "docs": [
       "Runtime governance authority for the program-vkey lifecycle and future",
       "explicit configuration instructions. Rotated only through the two-step",
       "`propose_admin_transfer` / `accept_admin_transfer` handshake; seeded at",
       "genesis from the `INIT_AUTHORITY` initializer."
      ],
      "type": "pubkey"
     },
     {
      "name": "pending_admin",
      "docs": [
       "Proposed replacement admin. Holds no authority until it signs",
       "`accept_admin_transfer`; overwritten by a new proposal, cleared by",
       "cancel or acceptance."
      ],
      "type": {
       "option": "pubkey"
      }
     },
     {
      "name": "program_vkey_hash",
      "docs": [
       "Active SP1 program vkey hash (`vk.bytes32()` of the prover guest);",
       "the default authorized input to `verify_block`'s SNARK check. Replaced",
       "only by proof-driven promotion of the pending key \u2014 no authority-driven",
       "activation path exists."
      ],
      "type": {
       "array": [
        "u8",
        32
       ]
      }
     },
     {
      "name": "pending_program_vkey_hash",
      "docs": [
       "Staged key. Authorized for proof verification from the moment it is",
       "staged; becomes the active key on its first successful block."
      ],
      "type": {
       "option": {
        "array": [
         "u8",
         32
        ]
       }
      }
     },
     {
      "name": "active_program_vkey_revoked",
      "docs": [
       "Emergency revocation flag for the active hash. A pending-key proof may",
       "still verify and replace the revoked active key."
      ],
      "type": "bool"
     },
     {
      "name": "next_withdrawal_nonce",
      "docs": [
       "Post-block withdrawal-nonce counter, committed from verified public IO and",
       "guarded for non-regression in `verify_block`. `execute_withdrawal` gates",
       "release by accepted roots + the per-nonce `ExecutedWithdrawal` PDA, not by",
       "this field; it tracks sequencer replay progress across blocks."
      ],
      "type": "u32"
     },
     {
      "name": "paused",
      "docs": [
       "Emergency stop. While set, the custody-sensitive instructions",
       "(`submit_deposit`, `verify_block`, `execute_withdrawal`) reject with",
       "`ProgramPaused`; governance instructions are never gated, so a paused",
       "program can always recover. Genesis starts paused and requires an",
       "explicit admin transition before custody instructions can execute."
      ],
      "type": "bool"
     },
     {
      "name": "min_deposit_amount",
      "docs": [
       "Anti-dust floor for `submit_deposit` amounts, in USDC base units.",
       "Zero disables the floor; `AmountZero` still rejects zero amounts.",
       "Raises the cost of spamming the per-block deposit admission ceiling",
       "(`MAX_DEPOSITS_PER_BLOCK`) with dust records."
      ],
      "type": "u64"
     },
     {
      "name": "custody_recovery_authority",
      "docs": [
       "Sole `recover_custody` signer: it can move the full custody balance of",
       "a paused instance, and only to this key's canonical USDC ATA. Set at",
       "genesis and rotated by the admin through",
       "`rotate_custody_recovery_authority`; must differ from the active and",
       "pending admin at every edge that sets either."
      ],
      "type": "pubkey"
     }
    ]
   }
