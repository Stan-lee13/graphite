{
  "$schema": "https://graphite.dev/schemas/verification-result-v1.json",
  "title": "Graphite VerificationResult",
  "description": "Output of the Graphite verification pipeline. Field parity with graphite-core/src/verification.rs VerificationResult (19 fields) and the TypeScript/Go SDKs. Security note: `approved` is the ONLY field a consumer may gate execution on; all other fields are evidence for audit.",
  "type": "object",
  "required": [
    "approved",
    "confidence",
    "breakdown",
    "trust_tier",
    "risk_verdict",
    "policy_verdict",
    "audit_trail_id",
    "content_hash",
    "transaction",
    "resolved_accounts",
    "protocol_name",
    "instruction_name",
    "manifest_found",
    "unknown_protocol",
    "summary"
  ],
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "breakdown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "raw_value",
          "weight",
          "contribution"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "raw_value": {
            "type": "number"
          },
          "weight": {
            "type": "number"
          },
          "contribution": {
            "type": "number"
          }
        }
      }
    },
    "trust_tier": {
      "type": "string",
      "enum": [
        "Unknown",
        "HeuristicInferred",
        "OfficialManifest",
        "SimulationValidated",
        "CommunityVerified",
        "BattleTested"
      ]
    },
    "risk_verdict": {
      "type": "object",
      "required": [
        "status",
        "findings"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Clear",
            "Blocked"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "reason"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "policy_verdict": {
      "type": "string"
    },
    "audit_trail_id": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "transaction": {
      "type": "object",
      "required": [
        "program_id",
        "protocol_version",
        "instruction_name",
        "instruction_discriminator",
        "instruction_count",
        "account_count",
        "signer_count",
        "writable_count",
        "compute_budget_units",
        "accounts",
        "data_hex",
        "data_len"
      ],
      "properties": {
        "program_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "string"
        },
        "instruction_name": {
          "type": "string"
        },
        "instruction_discriminator": {
          "type": "string"
        },
        "instruction_count": {
          "type": "integer",
          "minimum": 0
        },
        "account_count": {
          "type": "integer",
          "minimum": 0
        },
        "signer_count": {
          "type": "integer",
          "minimum": 0
        },
        "writable_count": {
          "type": "integer",
          "minimum": 0
        },
        "compute_budget_units": {
          "type": "integer",
          "minimum": 0
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "address",
              "is_signer",
              "is_writable"
            ],
            "properties": {
              "address": {
                "type": "string"
              },
              "is_signer": {
                "type": "boolean"
              },
              "is_writable": {
                "type": "boolean"
              }
            }
          }
        },
        "data_hex": {
          "type": "string"
        },
        "data_len": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resolved_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "address",
          "role",
          "is_pda",
          "is_signer",
          "is_writable",
          "pda_seeds"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "is_pda": {
            "type": "boolean"
          },
          "is_signer": {
            "type": "boolean"
          },
          "is_writable": {
            "type": "boolean"
          },
          "pda_seeds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identity": {
            "type": "string",
            "enum": [
              "Pda",
              "Constant",
              "Unverified"
            ],
            "description": "How this account's identity was verified. Unverified means genuinely externally-determined (no PDA formula, no fixed constant) \u2014 disclosed honestly rather than assumed safe."
          },
          "pda_mismatch": {
            "type": "boolean"
          },
          "expected_address_mismatch": {
            "type": "boolean",
            "description": "A manifest-declared fixed-constant slot (e.g. the SPL Token program) did not match the supplied address \u2014 a substitution attempt. Hard-blocks approval."
          },
          "privilege_mismatch": {
            "type": "boolean",
            "description": "A caller-supplied real AccountMeta disagreed with the manifest in a security-relevant direction: a required signer that is not actually signed, or a manifest-readonly slot marked writable. Hard-blocks approval."
          }
        }
      }
    },
    "protocol_name": {
      "type": "string"
    },
    "instruction_name": {
      "type": "string"
    },
    "manifest_found": {
      "type": "boolean"
    },
    "unknown_protocol": {
      "type": "boolean"
    },
    "manifest_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "simulation_flagged": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "simulation_divergence": {
      "type": [
        "number",
        "null"
      ]
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "layer",
          "passed",
          "reason"
        ],
        "properties": {
          "layer": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "inconclusive"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "description": "What this verdict is BOUND to, and what it did not observe. This is the field that makes Graphite's central promise checkable rather than assumed: the thing it approved is the thing that gets signed and executed, and every security-relevant property of that thing was either independently verified or explicitly identified as unverified. `approved` alone does not say which half applies \u2014 a verdict describing caller-supplied metadata and one bound to real signed bytes are otherwise the same shape. An execution gate that can move funds should require kind == 'artifact_bound' rather than gating on `approved` alone. ABSENT is not the same as 'descriptive': it means a pre-2026-09-08 server did not say, and must be treated as unknown.",
      "required": [
        "kind",
        "unobserved"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "artifact_bound",
            "descriptive"
          ]
        },
        "transaction_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "artifact_bound only. SHA-256 of the exact transaction bytes supplied, so a caller can recompute it over what it is about to submit and refuse if it differs. A stronger binding than content_hash, which covers a projection of one instruction and cannot see the fee payer, the blockhash, the signer set, or any sibling instruction."
        },
        "transaction_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "artifact_bound only. Length of the supplied artifact."
        },
        "simulated": {
          "type": "boolean",
          "description": "artifact_bound only. Whether a simulator actually executed those bytes. False means the artifact was hashed but never run, so the verdict still rests on static analysis of the described instruction."
        },
        "unobserved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Security-relevant properties Graphite did not independently establish, stated as what is missing rather than as caveats about the checks. Never empty: claiming to have observed everything is a strong assertion that must be argued for, not fall out of an empty list."
        }
      }
    }
  }
}
