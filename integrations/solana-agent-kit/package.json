{
  "name": "@graphite/sak-integration",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Graphite-verified Solana Agent Kit integration \u2014 every SAK transaction is verified by Graphite Core before execution.",
  "type": "module",
  "scripts": {
    "demo": "tsx demo.ts",
    "typecheck": "tsc --noEmit",
    "test:auditbind": "tsx --test auditbind.test.ts",
    "test": "tsx --test *.test.ts",
    "emit:artifact-fixture": "tsx emit-artifact-fixture.ts",
    "emit:corpus": "tsx emit-corpus.ts"
  },
  "dependencies": {
    "solana-agent-kit": "^2.0.10",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "nanoid": "3.3.19",
    "jsondiffpatch": "0.7.6",
    "langsmith": "0.6.3",
    "hono": "4.13.12",
    "ip-address": "10.7.2",
    "qs": "6.16.0"
  }
}
