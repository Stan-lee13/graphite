# Every name below is one the adapter (graphite-sak-bridge.ts) or the guard it
# drives (../agent-guard/guard.ts) actually reads.
# Round 19 (F-19-C6): this file used to say GRAPHITE_SERVER_URL and
# AI_LAYER_URL while the code read GRAPHITE_CORE_URL and GRAPHITE_AI_LAYER_URL,
# so a copied example silently fell back to localhost. The guard now refuses
# to start if an old name (GRAPHITE_SERVER_URL, GRAPHITE_URL, AI_LAYER_URL) is
# set without the new one.
# Round 29 (audit 2026-10-20, M6): this file claimed to list every variable
# and left out the spend limits and the message version. It lists all of them
# now, including the ones Round 29 added.

# Solana RPC. A local test validator by default; put a devnet endpoint here
# for devnet runs. https://, or http:// only to a loopback host (Round 29, M3):
# the RPC alone measures what a swap does to the wallet. Never commit a URL
# that carries an API key.
SOLANA_RPC_URL=http://127.0.0.1:8899

# Wallet secret key, base58 (devnet / test keys only — never a funded mainnet
# key). Deleted from the process environment once the guard has read it
# (Round 29, M8).
SOLANA_PRIVATE_KEY=

# Graphite Core. http:// is accepted only for a loopback host; anything else
# must be https:// so the API key is never sent in cleartext.
GRAPHITE_CORE_URL=http://127.0.0.1:7331
# The Core's Bearer key (GRAPHITE_API_KEY on the server).
GRAPHITE_API_KEY=

# AI layer (advisory only, Constitution P1). intent_parser.py --serve binds
# 127.0.0.1:8081 by default. Same transport rule as the Core.
GRAPHITE_AI_LAYER_URL=http://127.0.0.1:8081

# Optional: only needed to construct the (read-only, signing-refused)
# SolanaAgentKit agent. SAK keeps it in its own config to call a model.
OPENAI_API_KEY=

# --- Spending limits (spend-policy.ts) --------------------------------------
# REQUIRED: the most one transaction may take out of the wallet, in lamports
# (a transfer's amount; a swap's outflow measured on its exact bytes). The
# guard refuses to start without it (Round 29, M6).
GRAPHITE_MAX_TRANSFER_LAMPORTS=100000000
# Run without a per-transaction cap: "1" accepts that risk by name (logged at
# startup). Leave unset.
# GRAPHITE_ALLOW_UNCAPPED=
# Optional: the only transfer destinations allowed (comma-separated base58).
# Set but empty means none.
# GRAPHITE_ALLOWED_DESTINATIONS=
# Optional: the most all executed transactions together may take out of the
# wallet within the window, in lamports. In memory, per process.
# GRAPHITE_MAX_TOTAL_LAMPORTS=
# The aggregate's rolling window in seconds (default 3600).
# GRAPHITE_SPEND_WINDOW_SECONDS=
# Where the aggregate's spends and any submission whose outcome is unknown are
# kept across a restart (guard-state.ts). Unset: in memory, and a restart
# forgets both. One guard process per file (a lock file sits next to it).
# GRAPHITE_GUARD_STATE_FILE=
# One guard per wallet on this host (Round 32): every guard takes a lock named
# for its wallet's public key in this directory, and a second guard for the same
# wallet refuses to start. Default (Round 34): $XDG_RUNTIME_DIR/graphite-guard,
# else /run/graphite-guard if writable, else ~/.local/state/graphite-guard
# (%LOCALAPPDATA%\graphite-guard on Windows) -- never the temp directory, which
# cleaners empty. It must be this user's, mode 0700. The lock is re-checked
# before every spend; a guard whose lock was deleted stops spending. The lock names its
# owner by pid, so guards on other hosts or in other containers are not seen,
# even through a shared directory: run one guard per wallet across them.
# GRAPHITE_GUARD_LOCK_DIR=
# "1": start anyway while another guard runs for the same wallet. The spend
# limits then hold per guard, not per wallet. "0" or unset: refuse.
# GRAPHITE_GUARD_ALLOW_SHARED_WALLET=

# --- Swaps (swap-economics.ts, swap-envelope.ts) ----------------------------
# How far below the simulated output a route's own minimum may be, in basis
# points, when the request states no slippage (default 100; at most 500).
# GRAPHITE_SWAP_MAX_SLIPPAGE_BPS=
# Price floors, output units per input unit, e.g. "SOL/USDC=100,SOL/USDT=100".
# A swap with neither a floor nor a minimum stated in the request is refused.
# GRAPHITE_SWAP_MIN_RATES=
# "1" builds swaps with no price floor at all (an accepted risk, logged).
# GRAPHITE_SWAP_ALLOW_UNPRICED=
# Optional compute budget the guard puts in front of a swap (legacy/v0 only).
# GRAPHITE_SWAP_COMPUTE_UNIT_LIMIT=
# Priority fee in micro-lamports per compute unit; limit x price may allow at
# most 0.005 SOL.
# GRAPHITE_SWAP_COMPUTE_UNIT_PRICE=
# "1": create the wallet's own associated token account for the output mint
# (idempotent) when the route writes to it.
# GRAPHITE_SWAP_CREATE_OUTPUT_ATA=
# Retired in Round 19 (F-19-C2); read only to say so if it is still set.
# GRAPHITE_SWAP_ALLOW_UNVERIFIED_EXECUTION=

# --- Verification and transactions ------------------------------------------
# Residual codes accepted beyond the inherent ones (residual-policy.ts).
# GRAPHITE_ACCEPT_UNOBSERVED=
# Operator wallet profile override.
# GRAPHITE_WALLET_PROFILE=
# Message format: "legacy" (default; v0 when a route names lookup tables) or "1".
# GRAPHITE_TRANSACTION_VERSION=
