# Graphite Core Server — environment template
# Copy to .env (gitignored) and adapt. Every variable is optional, but see the
# notes: a keyless server is DEV ONLY.

# Bearer API key for every route except /health. REQUIRED: the server refuses
# to start without it, and refuses one shorter than 32 characters. Generate
# with e.g. `openssl rand -hex 32`.
GRAPHITE_API_KEY=

# Operator key for /admin/* (quarantine add / lift / list), Round 19. A
# DIFFERENT secret from GRAPHITE_API_KEY, at least 32 characters; the server
# refuses to start if it is shorter or equal to the verify key. Unset (the
# default) disables /admin/* entirely (403) — the verify key an agent holds
# is never accepted there. The CLI (`graphite quarantine ...`) does not need
# it: it works on the data directory directly, and refuses to write while a
# server holds that directory's lock.
GRAPHITE_ADMIN_API_KEY=

# Local development ONLY: `1` permits an UNAUTHENTICATED instance, and only on
# a loopback address. Leave unset everywhere else.
GRAPHITE_DEV_MODE=

# Per-IP request limit, requests/second (default 30).
GRAPHITE_RATE_LIMIT=30

# CORS: comma-separated allowed origins. Empty (default) = cross-origin
# browser calls DENIED. Server-to-server clients are unaffected.
GRAPHITE_CORS_ORIGINS=

# Optional live L3 simulation RPC endpoint (e.g. a Helius/QuickNode URL).
# Without it, L3 simulation stays "inconclusive" (honest, not faked).
# NOTE: this URL usually embeds your provider API key. Graphite redacts RPC
# endpoint URLs from every error it surfaces, so a provider outage cannot
# leak the key into an API response — but treat the value as a secret.
GRAPHITE_RPC_URL=

# Optional SECOND, independent RPC that L8 asks about inclusion (Round 12).
# One RPC can misreport whether a signature landed in either direction, and
# nothing inside its answer can show it. With a witness, an approved
# transaction is reported as executed only when both endpoints agree on the
# slot and outcome; EITHER endpoint's sighting of a transaction Graphite
# BLOCKED raises the alarm. Must be a different endpoint from GRAPHITE_RPC_URL
# (the server refuses to start otherwise) and needs GRAPHITE_RPC_URL set.
# Both URLs are validated at startup: http/https only, no fragment; a
# plaintext http endpoint on a non-loopback host is warned about. Neither
# URL is ever logged.
GRAPHITE_RPC_WITNESS_URL=

# Durable state directory: append-only audit log + semantic graph snapshot.
# The server PROBES this directory for writability at startup and refuses to
# boot if it cannot write — it will never serve traffic with no audit trail.
# It also holds an exclusive lock on <dir>/graphite.lock for the life of the
# process: a second server on the same directory refuses to start (Round 12).
GRAPHITE_DATA_DIR=./graphite-data

# Number of TRUSTED reverse-proxy hops in front of this server, for per-IP
# rate limiting. 0 (default) = ignore X-Forwarded-For entirely; use this
# whenever clients can reach the server directly.
#
# Set it to the ACTUAL number of proxies you control (1 for a single nginx /
# ALB / Cloudflare in front). Graphite reads the client IP by counting that
# many entries from the RIGHT of X-Forwarded-For, because proxies APPEND the
# peer they observed — the left end of that header is whatever the caller
# claimed, and trusting it lets anyone rotate the header to get a fresh rate
# limit bucket per request. Over-counting hops re-opens exactly that bypass,
# so set it to the real number, never higher.
GRAPHITE_TRUST_PROXY=0

# Log output format: "json" for structured logs (recommended for log
# aggregators); anything else for human-readable text. Level via RUST_LOG.
GRAPHITE_LOG_FORMAT=json
RUST_LOG=info

# Wallet policy profile, PINNED server-side. When set, the profile supplied in
# the /verify request body is IGNORED entirely.
#
# Set this in any deployment where the caller is not the wallet operator. The
# request body is written by the agent — the same agent that may be
# prompt-injected — so a caller-supplied profile is a policy the attacker gets
# to choose. Accepted: treasury | trading | gaming | enterprise |
# custom:<min_confidence>:<TrustTier>  (e.g. custom:0.8:OfficialManifest).
# An unparseable value is a startup error, never a silent fallback.
GRAPHITE_WALLET_PROFILE=

# Allow a caller-supplied Custom profile WEAKER than the weakest built-in
# profile (Gaming, 0.55). Off by default: otherwise a caller can send
# {"Custom":{"min_confidence":0.0,"min_trust_tier":"Unknown"}} and disable the
# confidence/trust-tier gate entirely. Only enable for a genuinely trusted,
# single-tenant deployment where the caller IS the operator.
GRAPHITE_ALLOW_PERMISSIVE_PROFILES=0

# Audit log rotation. The ACTIVE audit file is rotated to
# audit.jsonl.<unix-millis> once it exceeds this size, which bounds both disk
# growth and the dashboard endpoints' per-request scan cost. 0 disables
# rotation (single unbounded append-only file).
GRAPHITE_AUDIT_ROTATE_BYTES=67108864

# How many rotated archives to KEEP. 0 (default) keeps every archive forever,
# so the complete audit trail survives (Constitution P9) — set a number only
# if you accept that the oldest audit history is deleted to bound disk use.
GRAPHITE_AUDIT_MAX_ARCHIVES=0

# Optional plugin events file (observability).
GRAPHITE_PLUGIN_EVENTS_FILE=
