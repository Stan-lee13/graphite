# Graphite Core Server — environment template
# Copy to .env (gitignored) and adapt. Every variable is optional, but see the
# notes: a keyless server is DEV ONLY.

# Bearer API key for /verify and the dashboard API. REQUIRED for any non-dev
# deployment — without it the server runs unauthenticated. Generate with e.g.
# `openssl rand -hex 32`.
GRAPHITE_API_KEY=

# Per-IP request limit, requests/second (default 30).
GRAPHITE_RATE_LIMIT=30

# CORS: comma-separated allowed origins. Empty (default) = cross-origin
# browser calls DENIED. Server-to-server clients are unaffected.
GRAPHITE_CORS_ORIGINS=

# Optional live L3 simulation RPC endpoint (e.g. a Helius/QuickNode URL).
# Without it, L3 simulation stays "inconclusive" (honest, not faked).
GRAPHITE_RPC_URL=

# Durable state directory: append-only audit log + semantic graph snapshot.
GRAPHITE_DATA_DIR=./graphite-data

# Set to 1 ONLY when behind a trusted reverse proxy so X-Forwarded-For is
# honored for rate limiting. Never enable when directly exposed.
GRAPHITE_TRUST_PROXY=0

# Optional plugin events file (observability).
GRAPHITE_PLUGIN_EVENTS_FILE=
